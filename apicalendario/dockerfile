# Etapa 1: compilar el proyecto multi-módulo con Maven
FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app
COPY . .

# Se omiten las pruebas porque ApiApplicationTests levanta el contexto
# y requiere una base de datos disponible durante la construcción.
RUN mvn clean install -DskipTests

# Etapa 2: imagen liviana solo con el JRE y el jar ejecutable
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/presentacion/target/presentacion-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8080
CMD ["java", "-jar", "app.jar"]
