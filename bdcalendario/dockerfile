# Imagen oficial de PostgreSQL
FROM postgres:15

# Scripts de inicialización: se ejecutan una sola vez, cuando el volumen está vacío.
# El prefijo 01/02 garantiza el orden DDL -> DML.
COPY DDL_CalendarioLaboral.sql /docker-entrypoint-initdb.d/01_ddl.sql
COPY DML_CalendarioLaboral.sql /docker-entrypoint-initdb.d/02_dml.sql
